# Both spellings, deliberately. `node_modules/` with the trailing slash matches
# a DIRECTORY only, and git does not treat a symlink as a directory — so a
# worktree created inside this mount with `ln -s ../node_modules` produced an
# untracked, UNIGNORED symlink that `git add -A` then committed as mode 120000
# pointing at a sandbox path (d1307a9). Anyone who checked that branch out got a
# node_modules pointing nowhere and an npm ci that could not run.
node_modules
node_modules/
.next/
out/
build/
tmp/

# database / data
db/
src/data/gpx/*
!src/data/gpx/.gitkeep

# env — never commit any .env* variants holding secrets.
# .env.example IS tracked (it's the template with empty values) and is
# explicitly re-included on the last line.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.DS_Store
*.log
.idea/
.vscode/
.claude/

# Playwright
test-results/
playwright-report/
playwright-results.json
playwright/.cache/
.env*

# Quarantined dead files (bridge cannot unlink; safe to delete)
_graveyard/

# Playwright saved auth state (per-run, never commit)
playwright/.auth/

# Local one-off push/deploy helpers. They tend to accumulate credentials and
# branch names that mean nothing to anyone else.
push-*.sh
