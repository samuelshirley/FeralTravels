{
  "name": "trip-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed-demo-trip.ts",
    "migrate-sqlite": "tsx scripts/migrate-sqlite-to-neon.ts",
    "backfill-maps-nav": "tsx scripts/backfill-google-maps-nav.ts",
    "smoke-api": "tsx scripts/smoke-api.ts",
    "trial-account": "tsx --tsconfig tsconfig.scripts.json scripts/trial-account.ts",
    "test-user": "tsx --tsconfig tsconfig.scripts.json scripts/make-test-user.ts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:smoke": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test e2e/existing-trip.spec.ts e2e/login-google-button.spec.ts e2e/login-otp.spec.ts e2e/vehicle-crud.spec.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "sync-shared": "node scripts/sync-shared.mjs",
    "prune-branches": "bash scripts/prune-branches.sh",
    "extract-canonical-trip": "tsx --tsconfig tsconfig.scripts.json scripts/extract-canonical-trip.ts",
    "check-preview-env": "node scripts/check-preview-env.mjs",
    "check:shared": "vitest run --project unit src/lib/sharedMirror.test.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@auth/drizzle-adapter": "^1.11.2",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@tmcw/togeojson": "^7.1.2",
    "@vercel/analytics": "^2.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "drizzle-orm": "^0.36.4",
    "jose": "^6.2.9",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-resizable-panels": "^2.1.9",
    "resend": "^4.8.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
