# ---- Anthropic (Penny / chat replanning) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Google Maps (client side, exposed in browser) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ---- Postgres (Neon) ----
# Create a free project at https://neon.tech, then copy the pooled connection string.
# Use the pooled URL (sslmode=require) for DATABASE_URL.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ---- Auth.js (NextAuth v5) ----
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-32-byte-base64-string
# Public origin (set this in production; localhost is fine for dev)
AUTH_URL=http://localhost:3000

# ---- Google OAuth provider ----
# Create at https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...

# ---- Resend (email magic link) ----
# Get an API key at https://resend.com/api-keys
AUTH_RESEND_KEY=re_...
# In dev you can use onboarding@resend.dev. In prod, verify your own domain first.
AUTH_EMAIL_FROM=onboarding@resend.dev
