ANTHROPIC_API_KEY=
# Browser Maps JS (Next.js requires NEXT_PUBLIC_ for the client bundle).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional but strongly recommended for production: a second key used only by
# Node for Places REST (nearby fuel + parks). Use no HTTP referrer restriction
# (IP restriction on Vercel is fine). If unset, the server falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — referrer-locked keys cause 403 on the server.
GOOGLE_MAPS_SERVER_API_KEY=


# ---- Ops / debugging ----
# When '1', logs SSR vehicle-remediation gate decisions (user id only) for /trips routes.
# VEHICLE_REMEDIATION_DEBUG=1

# Paste your Neon pooled connection string here.
DATABASE_URL=

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Google OAuth ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Resend (email magic link) ----
AUTH_RESEND_KEY=
# Format: 'Display Name <address@domain.com>'. The display name materially
# helps with Gmail spam classification — bare addresses on a new sender
# domain land in spam much more often than named ones. Once Resend's domain
# verification is green for feraltravels.com, switch this to:
#   AUTH_EMAIL_FROM=Feral Travels <login@feraltravels.com>
AUTH_EMAIL_FROM=onboarding@resend.dev

# ---- TEMPORARY: instant email sign-in for QA / agents (remove before public launch) ----
# When AUTH_TEST_BACKDOOR=1 and AUTH_TEST_BACKDOOR_EMAIL is set, that exact
# address can sign in via "Email me a sign-in link" without Resend (instant session).
# On Vercel production, also set AUTH_TEST_BACKDOOR_ON_VERCEL_PROD=1 or it stays disabled.
# Optional: AUTH_TEST_BACKDOOR_SECRET — if set, login shows an extra password field and
# the value must match (shared secret for the team).
# AUTH_TEST_BACKDOOR=1
# AUTH_TEST_BACKDOOR_EMAIL=ai-test@feraltravels.com
# AUTH_TEST_BACKDOOR_SECRET=
# AUTH_TEST_BACKDOOR_ON_VERCEL_PROD=

# ---- Admin / cost guardrails ----
# Optional env restriction — must be a SUBSET of the hardcoded ADMIN_ALLOWLIST
# in src/server/auth/admin.ts. Cannot grant admin to anyone not in code.
ADMIN_EMAILS=samuelashirley@gmail.com
# Soft caps per user (Anthropic only — Google Maps client-side calls are not metered here)
REPLAN_REQUESTS_PER_HOUR=40
REPLAN_USD_CAP_PER_DAY=5

# ---- Google Maps Platform free-tier (per-SKU monthly call allowances) ----
# Google Maps Platform shifted from a unified $200/mo credit to per-SKU
# monthly free allowances in 2024. The admin dashboard subtracts these from
# the calendar-month call counts when showing "billable" Google spend so the
# headline number matches your real Google bill (which is usually $0).
#
# Verify these against:
#   https://developers.google.com/maps/billing-and-pricing/pricing
# and your own Google Cloud Console → Billing → Reports view. Defaults reflect
# the Maps Platform free tier as of late 2024 — Google updates this periodically.
GOOGLE_PLACES_FREE_CALLS_ESSENTIALS_PER_MONTH=10000
GOOGLE_PLACES_FREE_CALLS_PRO_PER_MONTH=5000
GOOGLE_PLACES_FREE_CALLS_ENTERPRISE_PER_MONTH=1000

# ---- E2E (Playwright) ----
# Email used by the seeded fixture user. Tests log in as this address via
# AUTH_TEST_BACKDOOR (auto-enabled for the test webServer in
# playwright.config.ts; do NOT set AUTH_TEST_BACKDOOR=1 in this .env or
# it'll bleed into your `npm run dev` sessions). Defaults to
# feral-e2e-fixture@feraltravels.test if unset.
# E2E_FIXTURE_EMAIL=feral-e2e-fixture@feraltravels.test
#
# Override the port the test webServer binds to. Default 4444. Useful if
# you have something else camped on 4444.
# E2E_PORT=4444
#
# Point the suite at an already-running app (skips spinning `next start`).
# Leave unset for the default self-hosted flow.
# E2E_BASE_URL=https://your-vercel-preview.vercel.app
#
# Set to 1 to leave test-created rows in the DB after the suite finishes
# (default cleans them up). Useful when debugging a failure.
# E2E_KEEP_DATA=1
#
# Dedicated address on your Resend-verified domain for the OTP login E2E
# test. The test submits it on /login (real Resend send), then reads the
# same 6-digit code from Postgres (`email_otp_codes`). Omit to auto-skip
# that test.
# E2E_OTP_EMAIL=e2e-otp@feraltravels.com