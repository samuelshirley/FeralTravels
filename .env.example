ANTHROPIC_API_KEY=
# Browser Maps JS (Next.js requires NEXT_PUBLIC_ for the client bundle).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional but strongly recommended for production: a second key used only by
# Node for Places REST (nearby fuel + parks). Use no HTTP referrer restriction
# (IP restriction on Vercel is fine). If unset, the server falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — referrer-locked keys cause 403 on the server.
GOOGLE_MAPS_SERVER_API_KEY=


# ---- Ops / debugging ----
# When '1', logs SSR vehicle-remediation gate decisions (user id only) for /trips routes.
# VEHICLE_REMEDIATION_DEBUG=1

# Paste your Neon pooled connection string here.
DATABASE_URL=

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Google OAuth ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Resend (email magic link) ----
AUTH_RESEND_KEY=
# Format: 'Display Name <address@domain.com>'. The display name materially
# helps with Gmail spam classification — bare addresses on a new sender
# domain land in spam much more often than named ones. Once Resend's domain
# verification is green for feraltravels.com, switch this to:
#   AUTH_EMAIL_FROM=Feral Travels <login@feraltravels.com>
AUTH_EMAIL_FROM=onboarding@resend.dev

# ---- Admin / cost guardrails ----
# Optional env restriction — must be a SUBSET of the hardcoded ADMIN_ALLOWLIST
# in src/server/auth/admin.ts. Cannot grant admin to anyone not in code.
ADMIN_EMAILS=samuelashirley@gmail.com
# Soft caps per user (Anthropic only — Google Maps client-side calls are not metered here)
REPLAN_REQUESTS_PER_HOUR=40
REPLAN_USD_CAP_PER_DAY=5

# ---- Account deletion ----
# 32-byte key (base64 or hex) used to encrypt the email address recorded in
# `deleted_users` when someone deletes their account, so /admin/deleted can show
# who left. Optional: with it unset, deletions still work and are still counted,
# but only the irreversible SHA-256 hash is stored and those rows can never be
# made readable. Generate one with:  openssl rand -base64 32
# Rotating this key makes every row written under the old key unreadable.
DELETED_USER_ENC_KEY=

# ---- Google Maps Platform free-tier (per-SKU monthly call allowances) ----
# Google Maps Platform shifted from a unified $200/mo credit to per-SKU
# monthly free allowances in 2024. The admin dashboard subtracts these from
# the calendar-month call counts when showing "billable" Google spend so the
# headline number matches your real Google bill (which is usually $0).
#
# Verify these against:
#   https://developers.google.com/maps/billing-and-pricing/pricing
# and your own Google Cloud Console → Billing → Reports view. Defaults reflect
# the Maps Platform free tier as of late 2024 — Google updates this periodically.
GOOGLE_PLACES_FREE_CALLS_ESSENTIALS_PER_MONTH=10000
GOOGLE_PLACES_FREE_CALLS_PRO_PER_MONTH=5000
GOOGLE_PLACES_FREE_CALLS_ENTERPRISE_PER_MONTH=1000

# ---- E2E (Playwright) ----
# There is NO auth bypass. Every authenticated spec mints a fresh fixture
# inbox and signs in through the REAL OTP email flow, so a meaningful local
# run needs a working AUTH_RESEND_KEY for NON-fixture sign-ins (the app must
# actually send the OTP email). Authenticated specs skip without this key.
# E2E signs in as fixture addresses (playwright-<run>-<n>@e2e.feraltravels.com)
# and reads the code from the guarded /api/test/otp endpoint — no mailbox and
# nothing to configure, for eleven of the twelve specs.
#
# The twelfth, e2e/login-otp.spec.ts, is the ONLY thing that proves the app can
# actually send a sign-in email. It signs in at an address on a Resend
# RECEIVING domain and reads the delivered message back through Resend's
# received-emails API — same account, same key, no extra vendor and no bill.
#
# Set up once: Resend dashboard → Receiving → add a domain. The managed option
# (<id>.resend.app) needs no DNS; a custom subdomain needs one MX record. Put
# that domain in E2E_INBOX_DOMAIN. Do NOT use e2e.feraltravels.com — that one
# has no MX on purpose and is the fixture pattern /api/test/otp is fenced by.
#
# Leave these empty and that one spec skips; set them WRONG and it fails
# loudly rather than skipping.
# E2E_INBOX_DOMAIN=
# RESEND_API_KEY=   # optional — defaults to AUTH_RESEND_KEY above
#
# /api/test/* fixture-DATA endpoints (seed/reset/cleanup — no session minting)
# are auto-enabled for the test webServer in playwright.config.ts via
# E2E_TEST_ENDPOINTS=1. Do NOT set that here or it'll bleed into your
# `npm run dev` sessions. They are hard-disabled on Vercel production.
# Optional shared secret (CI derives a per-run one): E2E_TEST_ENDPOINTS_SECRET=
#
# Override the port the test webServer binds to. Default 4444. Useful if
# you have something else camped on 4444.
# E2E_PORT=4444
#
# Point the suite at an already-running app (skips spinning `next start`).
# Leave unset for the default self-hosted flow.
# E2E_BASE_URL=https://your-vercel-preview.vercel.app
#
# Set to 1 to leave test-created rows in the DB after the suite finishes
# (default cleans them up). Useful when debugging a failure.
# E2E_KEEP_DATA=1
# --- Finn fuel engine ------------------------------------------------------
# Stations (Places search-along-route) and route geometry (Directions) both use
# GOOGLE_MAPS_SERVER_API_KEY above. Ensure "Places API (New)" is enabled on that
# key in Google Cloud (separate toggle from the legacy Places API). No fuel
# pricing — removed at the Google-only cutover.

# --- Subscriptions ---------------------------------------------------------
# Shared secret for POST /api/webhooks/revenuecat. Set the SAME string in the
# RevenueCat dashboard's webhook Authorization header. UNSET MEANS THE ROUTE
# REFUSES EVERYTHING WITH 503 — never default-open, and 503 is retryable so
# events queued during a misconfigured window still land once it is set.
# REVENUECAT_WEBHOOK_SECRET=

# Arms POST /api/purchase/test, which grants a subscription without Apple.
# OFF unless set to exactly 1. Exists only because StoreKit returns an empty
# product list until the Paid Applications Agreement is active, so there is no
# real purchase sheet to test against yet.
#
# This is only half the gate. The other half is the address SHAPE
# (sam+trial-<tag>@feraltravels.com), hardcoded in payments/testPurchase.ts
# where an env var cannot widen it — a pattern rather than a list because every
# test run wants a NEW account, and a list would mean editing this var before
# every run. Every grant writes subscription_events with source 'fake'.
#
# Set this to 0 (or unset it) the day RevenueCat goes live. No deploy needed.
# SUBSCRIPTION_TEST_PURCHASES=1

# The App Store listing, used by the web soft block's "Continue on iPhone".
# Falls back to an App Store search until the numeric id exists, which is only
# after the first submission — a working search page beats a guessed 404.
# NEXT_PUBLIC_APP_STORE_URL=
